---
import BaseLayout from "../layouts/BaseLayout.astro";
import fruta from "../assets/make/fruta.png";
import planta from "../assets/make/planta.png";
import frutaTorn from "../assets/make/fruta-torn.png";
import destacadoTorn from "../assets/make/destacado-torn.png";
---

<BaseLayout title="Cuentos de la Cultureza — Convocatoria abierta">
	<div class="home">
		<div class="home-inner">
			<!-- Hero -->
			<section class="hero">
				<div class="hero-copy">
					<h1><span>Cuentos de la</span><span>Cultureza</span></h1>

					<p class="eyebrow">Convocatoria <strong>abierta</strong></p>

					<p class="hero-description">
						Una invitación a imaginar, escribir y compartir historias sobre los vínculos de cuidado entre las personas,
						las comunidades y la naturaleza en América Latina y el Caribe.
					</p>

					<p class="deadline">Cierre: 30 de diciembre de 2026</p>

					<div class="reassurance">
						<span>No necesitas ser escritor o escritora profesional</span>
						<span>Sólo tener una historia que contar</span>
					</div>
				</div>

				<img
					class="hero-art"
					src="/mano-con-semilla-inicio.png"
					alt="Manos sosteniendo un puñado de tierra con una pequeña planta creciendo"
					width="1328"
					height="866"
					fetchpriority="high"
				/>
			</section>

			<!-- Tarjetas de participación -->
			<section class="participation-grid" aria-label="Cómo participar">
				<a
					class="participation-card how-card"
					href="mailto:cultureza@ciudadaniai.org?subject=Quiero%20participar%20en%20Cultureza"
				>
					<span class="card-title">Cómo<br />participar</span>

					<div class="fruit-mask" style={`mask-image:url("${frutaTorn.src}")`}></div>
					<img class="fruit" src={fruta.src} alt="" width="1024" height="585" loading="lazy" />

					<span class="card-link">
						Click aquí
						<svg width="36" height="36" viewBox="0 0 36 36" fill="none" aria-hidden="true">
							<path
								d="M13.3 8.9 22.2 17.8 13.3 26.7"
								stroke="currentColor"
								stroke-width="3"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
					</span>
				</a>

				<a class="participation-card rules-card" href="/mas-informacion#bases">
					<span class="card-title">Revisar las<br />bases</span>

					<img class="plant" src={planta.src} alt="" width="980" height="980" loading="lazy" />

					<span class="card-link">
						Click aquí
						<svg width="36" height="36" viewBox="0 0 36 36" fill="none" aria-hidden="true">
							<path
								d="M13.3 8.9 22.2 17.8 13.3 26.7"
								stroke="currentColor"
								stroke-width="3"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
					</span>
				</a>
			</section>

			<!-- Manifiesto -->
			<section class="story">
				<p class="story-first">
					<span class="cultureza-word" style={`--mask:url("${destacadoTorn.src}")`}>Cultureza</span> nos invita a mirar los
					vínculos que construimos con <strong>los territorios que habitamos, los seres vivos que nos rodean y las comunidades
					de las que somos parte.</strong>
				</p>

				<p class="story-second">
					Un río que <strong>alimenta</strong>, una huerta que se comparte, los saberes que pasan generaciones o una comunidad
					que se organiza para <strong>proteger su entorno</strong>.
				</p>
			</section>
		</div>
	</div>
</BaseLayout>

<style>
	.home {
		overflow: hidden;
	}

	.home-inner {
		width: min(1244px, calc(100% - 64px));
		margin: 0 auto;
	}

	/* Hero */
	.hero {
		position: relative;
		min-height: 960px;
		padding-top: 97px;
	}

	.hero-copy {
		position: relative;
		z-index: 2;
		width: 64%;
	}

	.hero h1 {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: -0.05em;
		font-family: var(--font-display);
	}

	.hero h1 span {
		display: block;
		font-weight: 800;
	}

	.hero h1 span:first-child {
		font-size: clamp(68px, 6.25vw, 90px);
		line-height: 1.06;
	}

	.hero h1 span:last-child {
		font-size: clamp(86px, 8.33vw, 120px);
		line-height: 0.92;
	}

	.eyebrow {
		margin: 34px 0 0 10px;
		color: var(--color-ink-soft);
		font-family: var(--font-display);
		font-size: 40px;
		font-weight: 500;
		line-height: 1.2;
	}

	.eyebrow strong {
		color: var(--color-brand);
		font-weight: 600;
	}

	.hero-description {
		width: min(672px, 100%);
		margin: 83px 0 0 14px;
		font-size: 30px;
		line-height: 1.34;
	}

	.deadline {
		margin: 72px 0 0 10px;
		color: var(--color-brand);
		font-size: 35px;
		font-weight: 600;
		line-height: 1.3;
	}

	.reassurance {
		display: flex;
		align-items: flex-start;
		flex-direction: column;
		gap: 10px;
		margin: 38px 0 0 10px;
	}

	.reassurance span {
		padding: 8px 15px 9px;
		color: var(--color-paper);
		background: var(--color-brand);
		font-size: 30px;
		font-weight: 600;
		line-height: 1.15;
	}

	.hero-art {
		position: absolute;
		z-index: 1;
		top: 95px;
		right: calc(50% - 50vw);
		width: clamp(480px, 48vw, 900px);
		height: auto;
		pointer-events: none;
	}

	/* Tarjetas */
	.participation-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 14px;
		margin-top: 20px;
	}

	.participation-card {
		position: relative;
		display: block;
		height: 242px;
		overflow: hidden;
		border-radius: 20px;
		box-shadow: 0 6px 0 #000;
		transition: transform 300ms linear, box-shadow 300ms linear;
	}

	.participation-card:hover,
	.participation-card:focus-visible {
		transform: translateY(-5px);
		box-shadow: 0 11px 0 #000;
	}

	.how-card {
		background: var(--color-lime);
	}

	.rules-card {
		background: #646464;
	}

	.card-title {
		position: absolute;
		z-index: 3;
		top: 44px;
		left: 76px;
		padding: 0 4px;
		color: var(--color-ink-soft);
		background: #fff;
		font-family: var(--font-display);
		font-size: 40px;
		font-weight: 700;
		line-height: 1.3;
	}

	.rules-card .card-title {
		color: #000;
		background: var(--color-lime);
	}

	.card-link {
		position: absolute;
		z-index: 3;
		bottom: 26px;
		left: 76px;
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 30px;
		font-weight: 300;
		line-height: 1.3;
		text-decoration: underline;
	}

	.rules-card .card-link {
		color: #fff;
	}

	.card-link svg {
		width: 36px;
		height: 36px;
		transition: transform 300ms linear;
	}

	.participation-card:hover .card-link svg {
		transform: translateX(8px);
	}

	.fruit-mask {
		position: absolute;
		top: 0;
		right: 15px;
		width: 307px;
		height: 175px;
		background: var(--color-paper);
		mask-repeat: no-repeat;
		mask-size: contain;
		mask-position: center;
	}

	.fruit {
		position: absolute;
		top: -8px;
		right: 0;
		width: 307px;
		height: 175px;
		object-fit: cover;
		transform: rotate(180deg) scaleY(-1);
	}

	.plant {
		position: absolute;
		right: -2px;
		bottom: 0;
		width: 294px;
		height: 243px;
		object-fit: contain;
		object-position: bottom;
		filter: grayscale(1);
	}

	/* Manifiesto */
	.story {
		min-height: 940px;
		padding: 140px 180px 80px 134px;
		color: var(--color-ink-soft);
		font-size: 38px;
		line-height: 55px;
	}

	.story p {
		margin: 0;
	}

	.story strong {
		color: var(--color-brand);
		font-weight: 600;
	}

	.story-first {
		width: 720px;
		max-width: 100%;
	}

	.cultureza-word {
		position: relative;
		z-index: 0;
		display: inline-block;
		margin-right: 8px;
		padding: 0 10px;
		color: var(--color-paper);
		font-family: var(--font-mono);
		font-size: 38px;
	}

	.cultureza-word::before {
		content: "";
		position: absolute;
		z-index: -1;
		inset: 2px -3px -1px;
		background: var(--color-brand);
		mask: var(--mask) center / 100% 100% no-repeat;
	}

	.story-second {
		width: 590px;
		max-width: 100%;
		margin-top: 75px !important;
		margin-left: auto !important;
		text-align: right;
	}

	@media (max-width: 1100px) {
		.hero {
			min-height: 930px;
		}

		.hero-copy {
			width: 72%;
		}

		.hero h1 span:first-child {
			font-size: 62px;
		}

		.hero h1 span:last-child {
			font-size: 82px;
		}

		.hero-art {
			top: 150px;
			right: calc(50% - 50vw);
			width: 58vw;
		}

		.hero-description {
			font-size: 25px;
		}

		.deadline {
			font-size: 29px;
		}

		.reassurance span {
			font-size: 23px;
		}

		.fruit,
		.fruit-mask {
			right: -75px;
		}

		.plant {
			right: -65px;
		}

		.story {
			padding-inline: 35px;
			font-size: 32px;
			line-height: 1.45;
		}

		.story-first {
			width: 65%;
		}
	}

	@media (max-width: 760px) {
		.home-inner {
			width: calc(100% - 40px);
		}

		.hero {
			min-height: auto;
			padding: 40px 0 92px;
			display: flex;
			flex-direction: column;
		}

		.hero-copy {
			width: 100%;
		}

		.hero h1 span:first-child {
			font-size: clamp(34px, 10.5vw, 66px);
			line-height: 1;
		}

		.hero h1 span:last-child {
			font-size: clamp(46px, 13.2vw, 80px);
			line-height: 1;
		}

		.hero-art {
			position: relative;
			top: auto;
			right: auto;
			width: calc(100% + 40px);
			height: auto;
			margin: 30px -20px 0;
			order: 2;
		}

		.eyebrow {
			margin: 22px 0 0;
			font-size: 26px;
		}

		.hero-description {
			margin: 30px 0 0;
			font-size: 20px;
		}

		.deadline {
			margin: 26px 0 0;
			font-size: 23px;
		}

		.reassurance {
			margin: 25px 0 0;
		}

		.reassurance span {
			padding: 7px 10px;
			font-size: 17px;
		}

		.participation-grid {
			grid-template-columns: 1fr;
			gap: 28px;
			margin-top: 0;
		}

		.participation-card {
			height: 220px;
		}

		.card-title {
			top: 35px;
			left: 30px;
			font-size: 29px;
		}

		.card-link {
			left: 30px;
			bottom: 25px;
			font-size: 21px;
		}

		.fruit,
		.fruit-mask {
			right: -80px;
			width: 280px;
		}

		.plant {
			right: -55px;
			width: 245px;
			height: 215px;
		}

		.story {
			min-height: auto;
			padding: 120px 2px 130px;
			font-size: 25px;
			line-height: 1.5;
		}

		.story-first,
		.story-second {
			width: 100%;
		}

		.cultureza-word {
			font-size: 24px;
		}

		.story-second {
			margin-top: 80px !important;
			padding-left: 15%;
		}
	}
</style>
