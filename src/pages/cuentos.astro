---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Cuentos de la Cultureza — Cuentos"
	description="Revisa acá los Cuentos premiados y seleccionados de la convocatoria Cuentos de la Cultureza."
>
	<div class="cuentos">
		<!-- Hero -->
		<section class="hero">
			<div class="container">
				<h1>Cuentos de la<br />Cultureza</h1>
			</div>

			<img
				class="hero-art"
				src="/mano-con-semilla-inicio.png"
				alt=""
				width="1328"
				height="866"
				fetchpriority="high"
				aria-hidden="true"
			/>
		</section>

		<!-- Próximamente -->
		<section class="coming-soon" aria-labelledby="coming-soon-title">
			<div class="container">
				<p id="coming-soon-title">
					Revisa acá los <strong>Cuentos premiados y seleccionados</strong>
				</p>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.cuentos {
		overflow: hidden;
	}

	.container {
		width: min(1244px, calc(100% - 64px));
		margin: 0 auto;
	}

	/* Hero */
	.hero {
		position: relative;
		min-height: 560px;
		padding-top: 105px;
	}

	.hero h1 {
		position: relative;
		z-index: 1;
		margin: 0;
		color: var(--color-ink);
		font-family: var(--font-display);
		font-size: clamp(58px, 7.3vw, 105px);
		font-weight: 800;
		line-height: 0.9;
		letter-spacing: -0.045em;
		text-transform: uppercase;
	}

	.hero-art {
		position: absolute;
		z-index: 0;
		top: 55px;
		right: calc(50% - 50vw);
		width: clamp(560px, 54vw, 900px);
		height: auto;
		pointer-events: none;
	}

	/* Aviso */
	.coming-soon {
		padding: 40px 0 150px;
	}

	.coming-soon p {
		max-width: 900px;
		margin: 0 auto;
		color: var(--color-ink-soft);
		font-family: var(--font-display);
		font-size: clamp(30px, 3.6vw, 52px);
		font-weight: 500;
		line-height: 1.15;
		text-align: center;
	}

	.coming-soon strong {
		color: var(--color-brand);
		font-weight: 900;
	}

	@media (max-width: 1100px) {
		.hero {
			min-height: 520px;
			padding-top: 70px;
		}

		.hero-art {
			width: 58vw;
			top: 60px;
		}
	}

	@media (max-width: 760px) {
		.container {
			width: calc(100% - 40px);
		}

		.hero {
			min-height: auto;
			padding: 28px 0 0;
		}

		.hero h1 {
			font-size: clamp(36px, 10.8vw, 70px);
		}

		.hero-art {
			position: relative;
			top: auto;
			right: auto;
			width: calc(100% + 40px);
			margin: 26px -20px 0;
		}

		.coming-soon {
			padding: 54px 0 90px;
		}

		.coming-soon p {
			font-size: clamp(25px, 7vw, 34px);
		}
	}
</style>
